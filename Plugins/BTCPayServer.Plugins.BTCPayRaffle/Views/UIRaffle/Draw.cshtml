@using BTCPayServer.Plugins.BTCPayRaffle.Data.Entities
@model BTCPayServer.Plugins.BTCPayRaffle.ViewModels.DrawViewModel
@{
    ViewData["Title"] = "Draw — " + Model.Raffle.Name;
    var totalDrawn = Model.Drawings.Count;
}

<div class="raffle-draw-page">

    <!-- Header -->
    <div class="text-center mb-4">
        <h2>@Model.Raffle.Name</h2>
        <p class="text-secondary">
            Total tickets: <strong>@Model.Raffle.Tickets.Count</strong> &nbsp;|&nbsp;
            Remaining: <strong id="eligibleCount">@Model.EligibleTicketsCount</strong>
        </p>
    </div>

    <!-- Drawing arena -->
    <div class="draw-arena">

        <div class="prize-label" id="prizeLabel">Ready to draw</div>

        <!-- Slot machine display -->
        <div class="slot-machine">
            <div class="slot-display">
                <div class="slot-reel" id="slotReel">
                    <div class="slot-number" id="currentNumber">?</div>
                </div>
            </div>
            <div class="slot-shine"></div>
        </div>

        <!-- Draw button -->
        <div class="draw-controls">
            <button id="drawBtn" class="btn-draw"
                    data-draw-url="@Url.Action("DrawNext", "UIRaffle", new { Model.StoreId, raffleId = Model.Raffle.Id })"
                    @(Model.CanDrawMore ? "" : "disabled")>
                @if (Model.CanDrawMore) { <span>🎲 Draw Next Prize</span> }
                else { <span>✅ All prizes drawn</span> }
            </button>
            @if (Model.CanUndoLastDraw)
            {
                <form method="post" asp-action="UndoLastDraw"
                      asp-route-storeId="@Model.StoreId"
                      asp-route-raffleId="@Model.Raffle.Id"
                      asp-antiforgery="true" class="mt-3"
                      onsubmit="return confirm('Undo the last draw? The winning ticket becomes eligible again.')">
                    <button type="submit" class="btn btn-outline-warning">↩ Undo last draw</button>
                </form>
            }
            @if (!Model.CanDrawMore && Model.Drawings.Any())
            {
                <form method="post" asp-action="Complete"
                      asp-route-storeId="@Model.StoreId"
                      asp-route-raffleId="@Model.Raffle.Id"
                      asp-antiforgery="true" class="mt-3">
                    <button class="btn btn-dark">Complete Raffle</button>
                </form>
            }
        </div>

        <!-- Winner reveal -->
        <div class="winner-panel" id="winnerPanel" style="display:none">
            <div class="winner-number" id="winnerNumber"></div>
            <div class="winner-info" id="winnerInfo"></div>
            <div class="winner-prize-badge" id="winnerPrizeBadge"></div>
        </div>

    </div>

    <!-- Drawn prizes history -->
    <div class="drawings-history mt-4">
        <h4 class="mb-3">Draw Results</h4>
        <div class="drawings-list" id="drawingsList">
            @if (!Model.Drawings.Any())
            {
                <p class="text-secondary text-center" id="noDrawingsMsg">No prizes drawn yet</p>
            }
            @foreach (var d in Model.Drawings.OrderByDescending(d => d.DrawOrder))
            {
                <div class="drawing-item @(d.DrawOrder == totalDrawn ? "first-prize" : "")">
                    <div class="drawing-medal">
                        @if (d.DrawOrder == totalDrawn)            { <text>🥇</text> }
                        else if (d.DrawOrder == totalDrawn - 1)    { <text>🥈</text> }
                        else if (d.DrawOrder == totalDrawn - 2)    { <text>🥉</text> }
                        else                                       { <text>🎖️</text> }
                    </div>
                    <div class="drawing-prize-name">
                        @(d.DrawOrder == totalDrawn ? "1st Prize" :
                          d.DrawOrder == totalDrawn - 1 ? "2nd Prize" :
                          d.DrawOrder == totalDrawn - 2 ? "3rd Prize" :
                          $"Prize #{totalDrawn - d.DrawOrder + 1}")
                    </div>
                    <div>Ticket <strong>#@d.WinningTicket.TicketNumber</strong></div>
                    <div class="text-secondary small">@d.DrawnAt.LocalDateTime.ToString("HH:mm:ss")</div>
                </div>
            }
        </div>
    </div>

</div>

@Html.AntiForgeryToken()

<!-- Confetti canvas -->
<canvas id="confettiCanvas"
        style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999"></canvas>

@section PageHeadContent {
<style>
/* ── Drawing arena ────────────────────────────────────────────────────── */
.raffle-draw-page { max-width: 860px; margin: 0 auto; padding: 1rem; }

.draw-arena {
    display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
    background: var(--btcpay-bg-secondary);
    border: 1px solid var(--btcpay-body-border-medium);
    border-radius: 24px; padding: 3rem 2rem; position: relative;
    box-shadow: 0 4px 20px rgba(0,0,0,.08);
}

.prize-label {
    font-size: 1.3rem; font-weight: 600; color: var(--btcpay-body-text-muted);
    transition: all .3s;
}
.prize-label.drawing { color: var(--btcpay-primary); animation: pulse .8s infinite; }
.prize-label.revealed { color: var(--btcpay-success, #16a34a); font-size: 1.5rem; }
@@keyframes pulse { 0%,100%{opacity:1}50%{opacity:.4} }

/* ── Slot machine ─────────────────────────────────────────────────────── */
.slot-machine { position: relative; width: 280px; }
.slot-display {
    background: var(--btcpay-bg-tile, #fff);
    border: 3px solid var(--btcpay-primary); border-radius: 16px; padding: 1.5rem;
    text-align: center; min-height: 160px; display: flex; align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--btcpay-primary) 15%, transparent);
}
.slot-number {
    font-size: 5.5rem; font-weight: 900; color: var(--btcpay-primary); font-family: monospace;
    min-width: 180px; display: block; text-align: center;
}
.slot-reel.spinning .slot-number { animation: numSpin .09s linear infinite; }
.slot-reel.stopped  .slot-number { animation: numStop .35s cubic-bezier(.23,1,.32,1) forwards; }
@@keyframes numSpin { 0%{transform:translateY(-8px);opacity:.7}50%{transform:translateY(0);opacity:1}100%{transform:translateY(8px);opacity:.7} }
@@keyframes numStop { 0%{transform:scale(1.3)}100%{transform:scale(1)} }
.slot-shine {
    position:absolute;top:0;left:0;right:0;height:50%;
    background:linear-gradient(180deg,rgba(255,255,255,.08),transparent);
    border-radius:16px 16px 0 0; pointer-events:none;
}

/* ── Draw button ──────────────────────────────────────────────────────── */
.btn-draw {
    background: linear-gradient(135deg,#f0c040,#e08000);
    color: #1a1a2e; border: none; border-radius: 50px;
    padding: 1.1rem 2.8rem; font-size: 1.25rem; font-weight: 800;
    cursor: pointer; text-transform: uppercase;
    box-shadow: 0 8px 24px rgba(240,192,64,.4); transition: all .2s;
}
.btn-draw:hover:not(:disabled) {
    transform:translateY(-3px); background:linear-gradient(135deg,#ffd700,#f0a000);
    box-shadow: 0 12px 32px rgba(240,192,64,.6);
}
.btn-draw:disabled { background:var(--btcpay-body-border-medium); color:var(--btcpay-body-text-muted); cursor:not-allowed; box-shadow:none; }

/* ── Winner panel ─────────────────────────────────────────────────────── */
.winner-panel {
    display:flex; flex-direction:column; align-items:center; gap:.5rem;
    background:var(--btcpay-success-bg, #d1fae5);
    border:2px solid var(--btcpay-success, #16a34a);
    border-radius:16px; padding:1.5rem 2.5rem; text-align:center;
}
.winner-panel.reveal { animation: revealAnim .6s cubic-bezier(.34,1.56,.64,1); }
@@keyframes revealAnim { 0%{transform:scale(.5);opacity:0}100%{transform:scale(1);opacity:1} }
.winner-number { font-size:4rem; font-weight:900; color:var(--btcpay-success,#16a34a); font-family:monospace; }
.winner-info   { font-size:1.15rem; color:var(--btcpay-body-text); }
.winner-prize-badge { font-size:.95rem; font-weight:700; padding:.3rem 1rem; border-radius:20px; }
.winner-prize-badge.prize-1 { background:linear-gradient(135deg,#ffd700,#ffa500); color:#1a1a2e; }
.winner-prize-badge.prize-2 { background:linear-gradient(135deg,#c0c0c0,#a0a0a0); color:#1a1a2e; }
.winner-prize-badge.prize-3 { background:linear-gradient(135deg,#cd7f32,#a05020); color:#fff; }

/* ── History ──────────────────────────────────────────────────────────── */
.drawings-list { display:flex; flex-direction:column; gap:.6rem; }
.drawing-item {
    display:grid; grid-template-columns:2.5rem 1fr 1fr auto;
    align-items:center; gap:.75rem;
    background:var(--btcpay-bg-tile, #fff); border:1px solid var(--btcpay-body-border-medium);
    border-radius:12px; padding:.75rem 1rem; transition:all .4s;
}
.drawing-item.first-prize { border-color:#f0c040; background:color-mix(in srgb,#ffd700 8%,var(--btcpay-bg-tile,#fff)); }
.drawing-medal { font-size:1.4rem; text-align:center; }
.drawing-item.new-item { transform:translateX(-20px); opacity:0; }
@@media(max-width:600px){
    .drawing-item{ grid-template-columns:2rem 1fr 1fr; }
    .slot-number{font-size:4rem;}
}
</style>
}

@section PageFootContent {
<script>
'use strict';
(function(){
    let isDrawing = false;
    const drawBtn    = document.getElementById('drawBtn');
    const slotReel   = document.getElementById('slotReel');
    const currentNum = document.getElementById('currentNumber');
    const prizeLabel = document.getElementById('prizeLabel');
    const winPanel   = document.getElementById('winnerPanel');
    const winNum     = document.getElementById('winnerNumber');
    const winInfo    = document.getElementById('winnerInfo');
    const winBadge   = document.getElementById('winnerPrizeBadge');
    const drawList   = document.getElementById('drawingsList');
    const eligibleEl = document.getElementById('eligibleCount');
    const canvas     = document.getElementById('confettiCanvas');
    const ctx2d      = canvas.getContext('2d');
    let   confettiAF = null;
    let   confetti   = [];

    function csrfToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    if (drawBtn) {
        drawBtn.addEventListener('click', async () => {
            if (isDrawing) return;
            isDrawing = true;
            drawBtn.disabled = true;
            winPanel.style.display = 'none';
            prizeLabel.textContent = 'Drawing…';
            prizeLabel.className = 'prize-label drawing';

            try {
                const res = await fetch(drawBtn.dataset.drawUrl, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': csrfToken(),
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                const data = await res.json();

                if (!data.success) {
                    alert(data.error ?? 'Draw failed');
                    prizeLabel.textContent = 'Ready to draw';
                    prizeLabel.className = 'prize-label';
                    isDrawing = false;
                    drawBtn.disabled = false;
                    return;
                }

                await animateSlot(data.ticketNumber);

                revealWinner(data);
                prependDrawingItem(data);

                const remaining = parseInt(eligibleEl.textContent) - 1;
                eligibleEl.textContent = remaining;

                startConfetti();
                setTimeout(stopConfetti, 5500);

                if (remaining > 0) {
                    setTimeout(() => {
                        isDrawing = false;
                        drawBtn.disabled = false;
                        currentNum.textContent = '?';
                        winPanel.style.display = 'none';
                        prizeLabel.textContent = 'Ready for next draw';
                        prizeLabel.className = 'prize-label';
                    }, 9000);
                } else {
                    drawBtn.querySelector('span').textContent = '✅ All prizes drawn';
                }
            } catch (e) {
                console.error(e);
                alert('Network error — please try again');
                isDrawing = false;
                drawBtn.disabled = false;
            }
        });
    }

    // ── Slot machine animation ─────────────────────────────────────────
    async function animateSlot(finalNumber) {
        const DURATION = 5600, FPS = 60;
        const totalFrames = (DURATION / 1000) * FPS;
        slotReel.classList.add('spinning');

        return new Promise(resolve => {
            let frame = 0;
            function tick() {
                frame++;
                const progress = frame / totalFrames;
                const changeEvery = Math.max(1, Math.round(progress * progress * 28));
                if (frame % changeEvery === 0) {
                    const fake = progress > .9
                        ? Math.max(1, finalNumber + Math.round((Math.random()-.5) * (1-progress) * 30))
                        : Math.floor(Math.random() * Math.max(100, finalNumber + 50)) + 1;
                    currentNum.textContent = fake;
                }
                if (frame < totalFrames) { requestAnimationFrame(tick); }
                else {
                    currentNum.textContent = finalNumber;
                    slotReel.classList.remove('spinning');
                    slotReel.classList.add('stopped');
                    setTimeout(() => { slotReel.classList.remove('stopped'); resolve(); }, 400);
                }
            }
            requestAnimationFrame(tick);
        });
    }

    // ── Winner reveal ──────────────────────────────────────────────────
    function revealWinner(data) {
        winNum.textContent = `#${data.ticketNumber}`;
        const parts = [];
        if (data.winnerName && data.winnerName !== '—') parts.push(data.winnerName);
        if (data.winnerEmail) parts.push(data.winnerEmail);
        winInfo.textContent = parts.length ? parts.join(' · ') : 'Anonymous';

        const order = data.drawOrder;
        winBadge.textContent = `Draw #${order}`;
        winBadge.className = `winner-prize-badge prize-${Math.min(order, 3)}`;

        winPanel.style.display = 'flex';
        winPanel.classList.add('reveal');
        setTimeout(() => winPanel.classList.remove('reveal'), 700);
        prizeLabel.textContent = '🎉 Winner drawn!';
        prizeLabel.className = 'prize-label revealed';
    }

    // ── Draw list prepend ──────────────────────────────────────────────
    function prependDrawingItem(data) {
        const noMsg = document.getElementById('noDrawingsMsg');
        if (noMsg) noMsg.remove();
        const item = document.createElement('div');
        item.className = 'drawing-item new-item';
        item.innerHTML = `
            <div class="drawing-medal">🎖️</div>
            <div>Draw #${data.drawOrder}</div>
            <div>Ticket <strong>#${data.ticketNumber}</strong></div>
            <div class="text-secondary small">${new Date(data.drawnAt).toLocaleTimeString()}</div>
        `;
        drawList.insertBefore(item, drawList.firstChild);
        requestAnimationFrame(() => item.classList.remove('new-item'));
    }

    // ── Confetti ───────────────────────────────────────────────────────
    function resize() { canvas.width = innerWidth; canvas.height = innerHeight; }
    window.addEventListener('resize', resize);
    resize();

    const COLORS = ['#f0c040','#ff4444','#44bb44','#4488ff','#ff88ff','#ffaa00','#00cccc'];

    function startConfetti() {
        confetti = Array.from({length: 200}, () => ({
            x: Math.random() * canvas.width, y: Math.random() * -canvas.height,
            w: 8 + Math.random()*12, h: 4 + Math.random()*6,
            color: COLORS[Math.floor(Math.random()*COLORS.length)],
            rot: Math.random() * Math.PI * 2,
            rs: (Math.random()-.5)*.2,
            vx: (Math.random()-.5)*4,
            vy: 2 + Math.random()*5,
            o: 1
        }));
        animateConfetti();
    }

    function animateConfetti() {
        ctx2d.clearRect(0,0,canvas.width,canvas.height);
        confetti.forEach(p => {
            p.x+=p.vx; p.y+=p.vy; p.rot+=p.rs;
            if (p.y > canvas.height) { p.y = -20; p.x = Math.random()*canvas.width; }
            ctx2d.save(); ctx2d.translate(p.x,p.y); ctx2d.rotate(p.rot);
            ctx2d.globalAlpha = p.o; ctx2d.fillStyle = p.color;
            ctx2d.fillRect(-p.w/2,-p.h/2,p.w,p.h); ctx2d.restore();
        });
        confettiAF = requestAnimationFrame(animateConfetti);
    }

    function stopConfetti() {
        if (confettiAF) { cancelAnimationFrame(confettiAF); confettiAF = null; }
        const fade = setInterval(() => {
            ctx2d.clearRect(0,0,canvas.width,canvas.height);
            confetti.forEach(p => {
                p.o -= .04;
                if (p.o > 0) {
                    ctx2d.save(); ctx2d.translate(p.x+=p.vx, p.y+=p.vy);
                    ctx2d.rotate(p.rot+=p.rs); ctx2d.globalAlpha=p.o;
                    ctx2d.fillStyle=p.color; ctx2d.fillRect(-p.w/2,-p.h/2,p.w,p.h); ctx2d.restore();
                }
            });
            if (confetti.every(p=>p.o<=0)) { clearInterval(fade); ctx2d.clearRect(0,0,canvas.width,canvas.height); }
        }, 50);
    }
})();
</script>
}
