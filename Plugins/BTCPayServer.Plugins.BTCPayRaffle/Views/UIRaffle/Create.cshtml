@model BTCPayServer.Plugins.BTCPayRaffle.ViewModels.CreateEditRaffleViewModel
@{
    ViewData["Title"] = "New Raffle";
    var storeId = ViewContext.RouteData.Values["storeId"];
}

<div class="row">
    <div class="col-xl-6">
        <h2 class="mb-4">🎟️ New Raffle</h2>
        <div class="card">
            <div class="card-body">
                <form method="post" asp-antiforgery="true">
                    <partial name="_RaffleFormFields" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create Raffle</button>
                        <a asp-action="Index" asp-route-storeId="@storeId" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section PageHeadContent {
<script>
const cur = document.getElementById('ticketCurrency');
const price = document.getElementById('ticketPrice');
const hint = document.getElementById('priceHint');
function refresh() {
    if (!cur || !price || !hint) return;
    const c = cur.value;
    const p = parseFloat(price.value) || 0;
    if (c === 'SATS') {
        price.step = '1';
        hint.textContent = p > 0 ? `≈ ${(p / 1e8).toFixed(8)} BTC` : '';
    } else {
        price.step = 'any';
        hint.textContent = `Price per ticket in ${c}`;
    }
}
cur?.addEventListener('change', refresh);
price?.addEventListener('input', refresh);
refresh();
</script>
}
