@using BTCPayServer.Plugins.BTCPayRaffle.Data.Entities
@model BTCPayServer.Plugins.BTCPayRaffle.ViewModels.TicketVerifyViewModel
@{
    ViewData["Title"] = T["verify.title"];
    Layout = "_LayoutSimple";

    var status = Model.Raffle.Status;
    var showWinner = Model.IsWinner && Model.IsWinnerRevealed;

    string? prizeName = null;
    if (showWinner && Model.DrawOrder.HasValue && Model.TotalDrawings > 0)
    {
        var rank = Model.TotalDrawings - Model.DrawOrder.Value + 1;
        prizeName = rank switch
        {
            1 => T["draw.prize_first"] + " 🥇",
            2 => T["draw.prize_second"] + " 🥈",
            3 => T["draw.prize_third"] + " 🥉",
            var n => T.Format("draw.prize_n", n)
        };
    }
}

<style>
.verify-page { max-width:520px; margin:0 auto; padding:1rem; }
.verify-header {
    background:linear-gradient(135deg,#1a1a2e,#0f3460); color:#fff;
    border-radius:16px; padding:1.75rem; text-align:center; margin-bottom:1.25rem;
}
.verify-header h2 { margin:0; font-size:1.35rem; }
.verify-header .raffle-sub { opacity:.85; font-size:.95rem; margin-top:.25rem; }
.ticket-card {
    border-radius:14px; overflow:hidden; margin-bottom:1.25rem;
    border:2px solid var(--btcpay-body-border-medium,#555);
    box-shadow:0 4px 16px rgba(0,0,0,.12);
}
.ticket-card.ticket-winner-card { border-color:#ffd700; box-shadow:0 4px 20px rgba(255,215,0,.35); }
.ticket-card-inner {
    background:linear-gradient(135deg,#1a1a2e,#0f3460); color:#fff;
    padding:1.5rem; text-align:center;
}
.ticket-card.ticket-winner-card .ticket-card-inner {
    background:linear-gradient(135deg,#b8860b,#ffd700); color:#1a1a1a;
}
.ticket-number {
    font-size:3.5rem; font-weight:900; font-family:monospace; line-height:1; margin:.35rem 0;
    color:#ffd700;
}
.ticket-card.ticket-winner-card .ticket-number { color:#1a1a1a; }
.buyer-name { font-size:.9rem; opacity:.85; margin-top:.25rem; }
.status-box {
    border-radius:12px; padding:1.25rem 1rem; text-align:center;
    border:2px solid transparent;
}
.status-box .status-icon { font-size:2.25rem; line-height:1; }
.status-box .status-title { font-size:1.2rem; font-weight:800; margin:.5rem 0 .25rem; }
.status-box .status-sub { font-size:.9rem; line-height:1.4; margin:0; }
.winner-box {
    background:linear-gradient(135deg,#d1fae5,#a7f3d0);
    border-color:#16a34a; color:#14532d;
}
.winner-box .status-sub { color:#166534; }
.open-box {
    background:linear-gradient(135deg,#fef3c7,#fde68a);
    border-color:#d97706; color:#78350f;
}
.open-box .status-sub { color:#92400e; }
.closed-box {
    background:linear-gradient(135deg,#dbeafe,#bfdbfe);
    border-color:#2563eb; color:#1e3a8a;
}
.closed-box .status-sub { color:#1d4ed8; }
.drawing-box {
    background:linear-gradient(135deg,#e0e7ff,#c7d2fe);
    border-color:#4f46e5; color:#312e81;
}
.drawing-box .status-sub { color:#4338ca; }
.loser-box {
    background:var(--btcpay-bg-secondary,#2a2a3e);
    border-color:var(--btcpay-body-border-medium,#555);
    color:var(--btcpay-body-text,#f0f0f0);
}
.loser-box .status-sub { color:var(--btcpay-body-text-muted,#b0b0b0); opacity:1; }
.verify-actions { text-align:center; margin-top:1.5rem; }
.verify-actions .btn-outline-secondary {
    border-color:var(--btcpay-primary,#f7931a); color:var(--btcpay-primary,#f7931a);
}
</style>

<div class="verify-page">

    <div class="verify-header">
        <div style="font-size:2.25rem">🎟️</div>
        <h2>@T["verify.title"]</h2>
        <div class="raffle-sub">@Model.Raffle.Name</div>
    </div>

    <div class="ticket-card @(showWinner ? "ticket-winner-card" : "")">
        <div class="ticket-card-inner">
            <div class="ticket-number">#@Model.Ticket.TicketNumber</div>
            @if (!string.IsNullOrEmpty(Model.Ticket.BuyerName))
            {
                <div class="buyer-name">@Model.Ticket.BuyerName</div>
            }
        </div>
    </div>

    @if (showWinner)
    {
        <div class="status-box winner-box">
            <div class="status-icon">🏆</div>
            <div class="status-title">@T["verify.winner"]</div>
            @if (prizeName is not null)
            {
                <p class="status-sub">@prizeName</p>
            }
        </div>
    }
    else if (Model.IsWinner && !Model.IsWinnerRevealed)
    {
        <div class="status-box drawing-box">
            <div class="status-icon">🎲</div>
            <div class="status-title">@T["verify.draw_in_progress"]</div>
            <p class="status-sub">@T["verify.draw_in_progress_sub"]</p>
        </div>
    }
    else if (status == RaffleStatus.Open)
    {
        <div class="status-box open-box">
            <div class="status-icon">⏳</div>
            <div class="status-title">@T["verify.raffle_in_progress"]</div>
            <p class="status-sub">@T["verify.raffle_in_progress_sub"]</p>
        </div>
    }
    else if (status == RaffleStatus.Closed)
    {
        <div class="status-box closed-box">
            <div class="status-icon">🔒</div>
            <div class="status-title">@T["wallet.sales_closed_soon"]</div>
            <p class="status-sub">@T["verify.sales_closed_sub"]</p>
        </div>
    }
    else if (status is RaffleStatus.Drawing)
    {
        <div class="status-box drawing-box">
            <div class="status-icon">🎲</div>
            <div class="status-title">@T["verify.draw_in_progress"]</div>
            <p class="status-sub">@T["verify.draw_in_progress_sub"]</p>
        </div>
    }
    else
    {
        <div class="status-box loser-box">
            <div class="status-icon">😔</div>
            <div class="status-title">@T["verify.not_winner"]</div>
            <p class="status-sub">@T["verify.not_winner_sub"]</p>
        </div>
    }

    <div class="verify-actions">
        <a href="@Url.Action("View", "RafflePublic", new { raffleId = Model.Raffle.Id })" class="btn btn-outline-secondary">
            @T["verify.back"]
        </a>
    </div>

</div>
