@using BTCPayServer.Abstractions.Extensions
@model BTCPayServer.Plugins.SepaInstantQr.Models.SepaSettingsPageViewModel
@{
    ViewData.SetActivePage("Wallets", "SEPA Instant QR", "SepaInstantQr");
    ViewData["Title"] = "SEPA Instant QR";
}

<partial name="_StatusMessage" />

<h2 class="mb-4">SEPA Instant QR</h2>

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <p class="text-muted">
            Customers pay by scanning a QR code with their banking app - an instant
            SEPA transfer straight to your own bank account. No card terminal, no
            intermediary, no custody.
        </p>

        <form method="post" asp-action="Settings" asp-route-storeId="@Model.StoreId">
            <div class="form-group form-check">
                <input asp-for="Settings.Enabled" type="checkbox" class="form-check-input" />
                <label asp-for="Settings.Enabled" class="form-check-label">Enable SEPA Instant QR on this store (EUR invoices only)</label>
            </div>

            <div class="form-group">
                <label asp-for="Settings.CountryProfile" class="form-label">Country profile</label>
                <select asp-for="Settings.CountryProfile" class="form-select w-auto">
                    <option value="SK">Slovakia - PayMe QR (payment link standard)</option>
                    <option value="CZ">Czechia - QR Platba (SPD)</option>
                    <option value="EU">EU generic - EPC QR (girocode)</option>
                </select>
                <div class="form-text">Determines the QR format and the payment reference style.</div>
            </div>

            <div class="form-group">
                <label asp-for="Settings.Iban" class="form-label">IBAN</label>
                <input asp-for="Settings.Iban" class="form-control font-monospace" placeholder="SK68 0720 0002 8919 8742 6353" />
                <span asp-validation-for="Settings.Iban" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Settings.Beneficiary" class="form-label">Beneficiary name</label>
                <input asp-for="Settings.Beneficiary" class="form-control" placeholder="My Company s.r.o." />
                <span asp-validation-for="Settings.Beneficiary" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Settings.Bic" class="form-label">BIC (optional)</label>
                <input asp-for="Settings.Bic" class="form-control font-monospace w-auto" />
            </div>

            <div class="form-group">
                <label asp-for="Settings.Message" class="form-label">Payment message (optional)</label>
                <input asp-for="Settings.Message" class="form-control" placeholder="Business name and branch" />
                <div class="form-text">Shown to the payer in their banking app.</div>
            </div>

            <div class="form-group">
                <label asp-for="Settings.ConfirmationBackend" class="form-label">Payment confirmation</label>
                <select asp-for="Settings.ConfirmationBackend" class="form-select w-auto">
                    <option value="manual">Manual - I confirm payments in my banking app</option>
                </select>
                <div class="form-text">
                    Automated backends (Slovak NOP notifications, Fio API, PSD2
                    account access) arrive in upcoming versions.
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Settings.AmountTolerance" class="form-label">Amount tolerance (EUR)</label>
                <input asp-for="Settings.AmountTolerance" type="number" step="0.01" min="0" max="10" class="form-control w-auto" />
                <div class="form-text">Automated matching accepts payments short by at most this amount. 0 = exact.</div>
            </div>

            <button type="submit" class="btn btn-primary mt-2">Save</button>
        </form>

        <form method="post" asp-action="TestBackend" asp-route-storeId="@Model.StoreId" class="mt-3">
            <button type="submit" class="btn btn-secondary">Test confirmation backend</button>
        </form>

        @if (Model.ReviewRequests.Count > 0)
        {
            <h4 class="mt-5">Needs review</h4>
            <p class="text-muted">A payment arrived but did not match the expected amount or currency. Verify it in your bank before confirming.</p>
            <table class="table">
                <thead>
                    <tr><th>Reference</th><th>Invoice</th><th>Due</th><th>Reason</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var row in Model.ReviewRequests)
                {
                    <tr>
                        <td class="font-monospace">@row.Reference</td>
                        <td><a asp-controller="UIInvoice" asp-action="Invoice" asp-route-invoiceId="@row.InvoiceId">@row.InvoiceId</a></td>
                        <td>@row.AmountDue.ToString("0.00") EUR</td>
                        <td>@row.ReviewReason</td>
                        <td>
                            <form method="post" asp-action="ConfirmManually" asp-route-storeId="@Model.StoreId" asp-route-reference="@row.Reference">
                                <button type="submit" class="btn btn-sm btn-outline-success">Mark as paid</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        @if (Model.PendingRequests.Count > 0)
        {
            <h4 class="mt-5">Awaiting payment</h4>
            <p class="text-muted">Confirm a payment here once you see the transfer in your banking app.</p>
            <table class="table">
                <thead>
                    <tr><th>Reference</th><th>Invoice</th><th>Due</th><th>Created</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var row in Model.PendingRequests)
                {
                    <tr>
                        <td class="font-monospace">@row.Reference</td>
                        <td><a asp-controller="UIInvoice" asp-action="Invoice" asp-route-invoiceId="@row.InvoiceId">@row.InvoiceId</a></td>
                        <td>@row.AmountDue.ToString("0.00") EUR</td>
                        <td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <form method="post" asp-action="ConfirmManually" asp-route-storeId="@Model.StoreId" asp-route-reference="@row.Reference">
                                <button type="submit" class="btn btn-sm btn-outline-success">Mark as paid</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
