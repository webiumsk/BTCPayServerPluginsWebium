<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>SEPA Instant QR</Product>
    <Description>Accept instant SEPA credit transfers via QR code (SK PayMe, CZ SPD, EU EPC QR) paid directly to the merchant's own bank account. Manual and automated payment confirmation backends. No custody.</Description>
    <Version>0.7.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- Suppressed for `EfMigrations=true dotnet ef ...` runs, which need the
       BTCPayServer assemblies in the output to load the design-time context. -->
  <ItemDefinitionGroup Condition="'$(EfMigrations)' != 'true'">
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
      <Private>false</Private>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BTCPayServer.Plugins.SepaInstantQr.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pin the full CodeAnalysis graph EF Design drags in (same fix as SatoshiTickets). -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      BTCPay Server reference - paths tried in order:
        1. BTCPay official plugin builder: btcpayserver as submodule in this repo (submodules/btcpayserver)
        2. Local dev: btcpayserver cloned as sibling to the repo root (../../../btcpayserver)
        3. Local dev fallback: BTCPayServerPluginsKukks sibling directory
    -->
    <ProjectReference Include="..\..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj"
                      Condition="Exists('..\..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj')" />
    <ProjectReference Include="..\..\..\btcpayserver\BTCPayServer\BTCPayServer.csproj"
                      Condition="!Exists('..\..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj') And Exists('..\..\..\btcpayserver\BTCPayServer\BTCPayServer.csproj')" />
    <ProjectReference Include="..\..\..\BTCPayServerPluginsKukks\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj"
                      Condition="!Exists('..\..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj') And !Exists('..\..\..\btcpayserver\BTCPayServer\BTCPayServer.csproj')" />
  </ItemGroup>
</Project>
