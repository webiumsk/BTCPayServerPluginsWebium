<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- StoreData blob (de)serialization reflects over BTCPayServer types that need
         these at runtime; BTCPay hosts them on the server, tests must ship them. -->
    <PackageReference Include="NBXplorer.Client" Version="5.0.5" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BTCPayServer.Plugins.CashuMelt\BTCPayServer.Plugins.CashuMelt.csproj" />
  </ItemGroup>
</Project>
