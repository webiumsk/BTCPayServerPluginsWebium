<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Cashu Melt</Product>
    <Description>Accept Cashu ecash or Lightning payments at checkout. Tokens are automatically melted to the merchant's Lightning address.</Description>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
      <Private>false</Private>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>


  <ItemGroup>
    <!--
      BTCPay Server reference — two paths supported:
        1. CI / official BTCPay builder: btcpayserver cloned as sibling to the plugin repo root
           (e.g. /btcpayserver/ when plugin is at /build/)
        2. Local dev with BTCPayServerPluginsKukks checked out as a sibling directory
    -->
    <ProjectReference Include="..\..\..\btcpayserver\BTCPayServer\BTCPayServer.csproj"
                      Condition="Exists('..\..\..\btcpayserver\BTCPayServer\BTCPayServer.csproj')" />
    <ProjectReference Include="..\..\..\BTCPayServerPluginsKukks\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj"
                      Condition="!Exists('..\..\..\btcpayserver\BTCPayServer\BTCPayServer.csproj')" />
  </ItemGroup>
</Project>
