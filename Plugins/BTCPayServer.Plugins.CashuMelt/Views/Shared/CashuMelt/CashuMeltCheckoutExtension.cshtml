@* CashuMelt checkout Vue component - QR code + polling *@
@model BTCPayServer.Models.InvoicingModels.CheckoutModel

<template id="CashuMeltCheckout">
    <div class="payment-box">
        <div v-if="paymentComplete" class="text-center py-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle text-success mb-3" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
            </svg>
            <h4>Payment Received!</h4>
            <p class="text-muted">Your CashuMelt payment has been confirmed.</p>
        </div>

        <div v-else class="text-center">
            <div class="qr-container clipboard-button mb-3" :data-qr-value="cashuBolt11" :data-clipboard="cashuUri">
                <qrcode v-if="cashuBolt11" :value="cashuUri" :options="qrOptions"></qrcode>
            </div>
            <p class="mb-2">
                <strong>{{ cashuAmountSats }} {{ cashuUnit }}</strong>
            </p>
            <p class="text-muted small mb-3">
                Pay with your CashuMelt wallet. Scan the QR code or copy the Lightning invoice.
            </p>
            <div v-if="pollError" class="alert alert-warning mb-3">
                {{ pollError }}
            </div>
            <div v-else class="text-muted small">
                <span v-if="polling" class="spinner-border spinner-border-sm me-1" role="status"></span>
                Waiting for payment...
            </div>
        </div>
    </div>
</template>

<script src="~/vendor/vue-qrcode/vue-qrcode.min.js"></script>
<script>
(function() {
    if (typeof Vue === 'undefined') return;

    Vue.component('CashuMeltCheckout', {
        props: ['model', 'nfcSupported', 'nfcScanning', 'nfcErrorMessage', 'nfcWarningMessage'],
        template: '#CashuMeltCheckout',
        components: {
            qrcode: window.VueQrcode
        },
        data() {
            return {
                polling: false,
                pollInterval: null,
                paymentComplete: false,
                pollError: null,
                qrOptions: {
                    width: 256,
                    margin: 1,
                    color: { dark: '#000000', light: '#ffffff' }
                }
            };
        },
        computed: {
            cashuQuoteId() { return this.model?.cashuQuoteId; },
            cashuBolt11() { return this.model?.cashuBolt11; },
            cashuAmountSats() { return this.model?.cashuAmountSats; },
            cashuUnit() { return this.model?.cashuUnit || 'sat'; },
            cashuUri() {
                var bolt11 = this.cashuBolt11;
                if (!bolt11) return '';
                return bolt11.startsWith('lnbc') ? 'lightning:' + bolt11 : bolt11;
            }
        },
        watch: {
            cashuQuoteId: {
                handler(val) {
                    if (val) this.startPolling();
                    else this.stopPolling();
                },
                immediate: true
            }
        },
        beforeDestroy() {
            this.stopPolling();
        },
        methods: {
            startPolling() {
                this.stopPolling();
                if (!this.cashuQuoteId || this.paymentComplete) return;
                this.polling = true;
                this.pollError = null;
                this.pollInterval = setInterval(() => this.checkPayment(), 2000);
                this.checkPayment();
            },
            stopPolling() {
                if (this.pollInterval) {
                    clearInterval(this.pollInterval);
                    this.pollInterval = null;
                }
                this.polling = false;
            },
            async checkPayment() {
                if (!this.cashuQuoteId) return;
                try {
                    var r = await fetch('/plugins/cashumelt/poll/' + encodeURIComponent(this.cashuQuoteId));
                    var json = await r.json();
                    if (json.paid) {
                        this.paymentComplete = true;
                        this.stopPolling();
                        // Reload so BTCPay's checkout handles the success state:
                        // shows celebration, return-to-merchant link, and auto-redirect.
                        // Works for both direct checkout URLs (PoS terminal) and iframe embeds.
                        setTimeout(() => window.location.reload(), 2000);
                    } else if (json.error) {
                        this.pollError = json.error;
                    }
                } catch (e) {
                    this.pollError = 'Failed to check payment status';
                }
            }
        }
    });
})();
</script>
