@using BTCPayServer.Abstractions.Extensions
@using System.Globalization
@using System.Text.Json
@using BTCPayServer.Plugins.SatfluxTickets.Services
@using BTCPayServer.Abstractions.Services
@using BTCPayServer.Plugins.SatfluxTickets.Data
@using BTCPayServer.Plugins.SatfluxTickets.ViewModels
@inject Safe Safe
@model TicketSalesPageViewModel
@{
    Layout = "_BaseSimpleTicketPublicLayout";
    var t = Model.Text;
    var publicRoot = Context.Request.GetAbsoluteRootUri();
    var shareImage = TicketSalesSocialMetadata.ImageUrl(publicRoot, Model.EventImageUrl, Model.StoreBranding?.LogoUrl);
    var shareUrl = TicketSalesSocialMetadata.AbsoluteHttpUrl(publicRoot, Url.Action("EventSummary", "UITicketSalesPublic", new { storeId = Model.StoreId, eventId = Model.EventId }));
    if (shareUrl != null) shareUrl = new Uri(shareUrl).GetLeftPart(UriPartial.Path);
    Model.VenueDates.TryGetValue(t.Language, out var venueDates);
    var configuration = JsonSerializer.Serialize(new {
        timeMode = Model.IsPhysical ? "venue" : "visitor",
        venueDates = Model.VenueDates.ToDictionary(x => x.Key, x => new { start = x.Value.Start, end = x.Value.End, label = x.Value.Label }),
        language = t.Language, currency = Model.Currency, decimals = Model.CurrencyDecimals,
        types = Model.TicketTypes.Select(x => new { id = x.Id, name = x.Name, price = x.Price, maximum = x.Maximum, selected = x.Selected }),
        contacts = Model.ContactInfo.Select(x => new { typeId = x.TicketTypeId, admissionIndex = x.AdmissionIndex, firstName = x.FirstName, lastName = x.LastName, email = x.Email }),
        contactsOpen = Model.ContactsOpen, frozen = Model.CheckoutStarted, checkoutUrl = Model.CheckoutUrl,
        copy = t.ClientCopy(), translations = TicketSalesText.Translations()
    });
}
@section PageHeadContent {
    <meta property="og:title" content="@Model.EventTitle" />
    <meta property="og:type" content="website" />
    @if (shareUrl != null)
    {
        <meta property="og:url" content="@shareUrl" />
        <link rel="canonical" href="@shareUrl" />
    }
    @if (shareImage != null)
    {
        <meta property="og:image" content="@shareImage" />
        <meta property="og:image:alt" content="@Model.EventTitle" />
    }
    <link rel="stylesheet" href="@Url.Action("SalesStyleVersioned", "UITicketSalesPublic", new { storeId = Model.StoreId, version = TicketSalesText.StyleVersion })" />
}
<div class="ticket-sales" data-ticket-sales>
    <header class="sales-brand">
        <span>@Model.StoreName</span>
        <div class="sales-language-controls">
            <label class="visually-hidden" for="sales-language" data-sales-copy="Language">@t["Language"]</label>
            <select id="sales-language" data-sales-language class="form-select w-auto">
                @foreach (var option in new[] { ("en", "English"), ("sk", "Slovenčina"), ("es", "Español"), ("de", "Deutsch"), ("cs", "Čeština") })
                {
                    <option value="@option.Item1" selected="@(t.Language == option.Item1)">@option.Item2</option>
                }
            </select>
        </div>
    </header>
    <p class="alert alert-warning" role="alert" data-sales-startup-error data-sales-copy="StartupError" hidden>@t["StartupError"]</p>
    <noscript><div class="alert alert-warning">@t["Javascript"]</div></noscript>
    @if (!string.IsNullOrEmpty(Model.ErrorKey))
    {
        <div class="alert alert-danger sales-error" role="alert" tabindex="-1" data-sales-error data-sales-copy="@Model.ErrorKey">@t[Model.ErrorKey]</div>
    }
    @if (Model.CheckoutStarted && string.IsNullOrEmpty(Model.ErrorKey))
    {
        <div class="alert alert-info" role="status" data-sales-copy="@(Model.CheckoutUrl == null ? "PendingVerification" : "CheckoutStarted")">@t[Model.CheckoutUrl == null ? "PendingVerification" : "CheckoutStarted"]</div>
    }
    <form asp-action="SubmitSale" asp-route-storeId="@Model.StoreId" asp-route-eventId="@Model.EventId" method="post" class="sales-grid" data-sales-form>
        <input type="hidden" name="TxnId" value="@Model.TxnId" />
        <input type="hidden" name="Language" value="@t.Language" data-sales-language-field />
        <input type="hidden" name="ContactsOpen" value="@(Model.ContactsOpen ? "true" : "false")" data-sales-contacts-open />
        <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true" data-sales-copy="Pay">@t["Pay"]</button>
        <main class="sales-main">
            <section class="sales-hero" aria-labelledby="sales-event-title">
                @if (!string.IsNullOrEmpty(Model.EventImageUrl))
                {
                    <button type="button" class="sales-poster" data-sales-enlarge data-sales-copy-aria="Enlarge" aria-label="@t["Enlarge"]">
                        <img src="@Model.EventImageUrl" alt="@Model.EventTitle" />
                        <span data-sales-copy="Enlarge">@t["Enlarge"]</span>
                    </button>
                }
                <div class="sales-intro">
                    <span class="sales-kicker" data-sales-copy="@(Model.EventType == EventType.Virtual ? "Virtual" : "Physical")">@(Model.EventType == EventType.Virtual ? t["Virtual"] : t["Physical"])</span>
                    <h1 id="sales-event-title">@Model.EventTitle</h1>
                    <dl class="sales-details">
                        <div><dt data-sales-copy="Starts">@t["Starts"]</dt><dd><time data-sales-local-time data-sales-time-part="start" datetime="@DateTime.SpecifyKind(Model.StartDate, DateTimeKind.Utc).ToString("O")">@(venueDates?.Start ?? t.Date(Model.StartDate))</time></dd></div>
                        @if (Model.EndDate.HasValue)
                        {
                            <div><dt data-sales-copy="Ends">@t["Ends"]</dt><dd><time data-sales-local-time data-sales-time-part="end" datetime="@DateTime.SpecifyKind(Model.EndDate.Value, DateTimeKind.Utc).ToString("O")">@(venueDates?.End ?? t.Date(Model.EndDate.Value))</time></dd></div>
                        }
                        @if (Model.EventType == EventType.Physical && !string.IsNullOrWhiteSpace(Model.Location))
                        {
                            <div><dt data-sales-copy="Location">@t["Location"]</dt><dd>@Model.Location</dd></div>
                        }
                    </dl>
                    <p class="sales-muted sales-small" data-sales-timezone hidden="@(venueDates == null)">@venueDates?.Label</p>
                    @if (Model.MissingVenueTimeZone)
                    {
                        <p class="sales-muted sales-small" data-sales-copy="MissingVenueTimezone">@t["MissingVenueTimezone"]</p>
                    }
                    <p class="sales-muted sales-delivery" data-sales-copy="@(Model.EventType == EventType.Virtual ? "VirtualNote" : "DeliveryNote")">@t[Model.EventType == EventType.Virtual ? "VirtualNote" : "DeliveryNote"]</p>
                </div>
            </section>
            <section class="sales-section" aria-labelledby="sales-choose-title">
                <div class="sales-section-heading"><span class="sales-step" aria-hidden="true">1</span><h2 id="sales-choose-title" data-sales-copy="ChooseTickets">@t["ChooseTickets"]</h2></div>
                <p class="sales-muted sales-small" data-sales-copy="Limit">@t["Limit"]</p>
                @if (Model.TicketTypes.Count == 0)
                {
                    <p class="sales-empty" data-sales-copy="NoOffer">@t["NoOffer"]</p>
                }
                <div class="sales-types">
                    @for (var i = 0; i < Model.TicketTypes.Count; i++)
                    {
                        var type = Model.TicketTypes[i];
                        <article class="sales-type @(type.Selected > 0 ? "is-selected" : "")" data-sales-type="@type.Id">
                            <div class="sales-type-description">
                                <h3 id="sales-type-title-@i">@type.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(type.Description))
                                {
                                    <p>@type.Description</p>
                                }
                                <strong class="sales-price">@t.Money(type.Price, Model.CurrencyDecimals, Model.Currency)</strong>
                                @if (type.Maximum == 0)
                                {
                                    <span class="sales-stock" data-sales-copy="SoldOut">@t["SoldOut"]</span>
                                }
                            </div>
                            <div class="sales-quantity" role="group" aria-labelledby="sales-type-title-@i">
                                <input type="hidden" name="Tickets[@i].TicketTypeId" value="@type.Id" />
                                <button type="button" data-sales-minus aria-label="@t["Decrease"]: @type.Name" disabled="@(Model.CheckoutStarted || type.Selected <= 0)">−</button>
                                <label class="visually-hidden" for="sales-quantity-@i">@t["Quantity"]: @type.Name</label>
                                <input id="sales-quantity-@i" data-sales-quantity type="number" inputmode="numeric" name="Tickets[@i].Quantity" value="@type.Selected" min="0" max="@type.Maximum" step="1" autocomplete="off" readonly="@Model.CheckoutStarted" aria-describedby="sales-availability" />
                                <button type="button" data-sales-plus aria-label="@t["Increase"]: @type.Name" disabled="@(Model.CheckoutStarted || type.Selected >= type.Maximum)">+</button>
                            </div>
                        </article>
                    }
                </div>
                <p class="sales-muted sales-small" id="sales-availability" data-sales-copy="AvailabilityNote">@t["AvailabilityNote"]</p>
            </section>
            <section class="sales-section sales-contacts" aria-labelledby="sales-contact-title" data-sales-contacts hidden>
                <div class="sales-section-heading"><span class="sales-step" aria-hidden="true">2</span><h2 id="sales-contact-title" tabindex="-1" data-sales-copy="Contacts">@t["Contacts"]</h2></div>
                <fieldset class="sales-delivery-options">
                    <legend class="visually-hidden" data-sales-copy="Contacts">@t["Contacts"]</legend>
                    <label><input type="radio" name="DeliveryOption" value="together" checked="@(Model.DeliveryOption != "individual")" disabled="@Model.CheckoutStarted" /><span data-sales-copy="Together">@t["Together"]</span></label>
                    <label><input type="radio" name="DeliveryOption" value="individual" checked="@(Model.DeliveryOption == "individual")" disabled="@Model.CheckoutStarted" /><span data-sales-copy="Individual">@t["Individual"]</span></label>
                </fieldset>
                <div class="sales-field" data-sales-shared-email>
                    <label for="sales-shared-email" data-sales-copy="Email">@t["Email"]</label>
                    <input class="form-control" type="email" id="sales-shared-email" name="SharedEmail" value="@Model.SharedEmail" maxlength="254" autocomplete="email" readonly="@Model.CheckoutStarted" />
                </div>
                <div data-sales-recipients></div>
            </section>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <section class="sales-section sales-about" aria-labelledby="sales-about-title">
                    <h2 id="sales-about-title" data-sales-copy="About">@t["About"]</h2>
                    <div class="sales-rich-description">@Safe.RawRichText(Model.Description)</div>
                </section>
            }
        </main>
        <aside class="sales-summary" aria-labelledby="sales-summary-title">
            <div class="sales-summary-panel">
                <span class="sales-kicker">@Model.StoreName</span>
                <h2 id="sales-summary-title" data-sales-copy="Summary">@t["Summary"]</h2>
                <p class="sales-summary-event">@Model.EventTitle</p>
                <div class="sales-summary-items" data-sales-summary><p class="sales-muted" data-sales-copy="NoTickets">@t["NoTickets"]</p></div>
                <div class="sales-total"><span data-sales-copy="Total">@t["Total"]</span><strong data-sales-total>@t.Money(0, Model.CurrencyDecimals, Model.Currency)</strong></div>
                @if (!string.IsNullOrEmpty(Model.CheckoutUrl))
                {
                    <a href="@Model.CheckoutUrl" class="btn btn-primary sales-primary" data-sales-copy="Pay">@t["Pay"]</a>
                }
                else
                {
                    <button type="button" class="btn btn-primary sales-primary" data-sales-primary disabled data-sales-copy="Continue">@t["Continue"]</button>
                }
                <p class="sales-muted sales-small sales-payment-note" data-sales-copy="PaymentNote">@t["PaymentNote"]</p>
                <p class="sales-small text-danger" data-sales-zero hidden data-sales-copy="ZeroPrice">@t["ZeroPrice"]</p>
                <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-sales-live></div>
            </div>
        </aside>
        <div class="sales-mobile-action">
            <div><span class="sales-muted sales-small" data-sales-copy="Total">@t["Total"]</span><strong data-sales-total>@t.Money(0, Model.CurrencyDecimals, Model.Currency)</strong></div>
            @if (!string.IsNullOrEmpty(Model.CheckoutUrl))
            {
                <a href="@Model.CheckoutUrl" class="btn btn-primary" data-sales-copy="Pay">@t["Pay"]</a>
            }
            else
            {
                <button type="button" class="btn btn-primary" data-sales-primary disabled data-sales-copy="Continue">@t["Continue"]</button>
            }
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.EventImageUrl))
    {
        <dialog class="sales-image-dialog" aria-labelledby="sales-image-title" data-sales-image-dialog>
            <h2 id="sales-image-title" class="visually-hidden">@Model.EventTitle</h2>
            <button type="button" class="btn btn-secondary" data-sales-close-image data-sales-copy="Close">@t["Close"]</button>
            <img src="@Model.EventImageUrl" alt="@Model.EventTitle" />
        </dialog>
    }
    <script type="application/json" data-sales-configuration>@Html.Raw(configuration)</script>
</div>
@section PageFootContent {
    <script src="@Url.Action("SalesScriptVersioned", "UITicketSalesPublic", new { storeId = Model.StoreId, version = TicketSalesText.ScriptVersion })" defer></script>
}
