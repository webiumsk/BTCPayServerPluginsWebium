@using BTCPayServer.Plugins.SatfluxTickets.ViewModels
@inject BTCPayServer.Services.BTCPayServerEnvironment Env
@model BaseSimpleTicketPublicViewModel
@{
    Layout = null;
    ViewData["StoreBranding"] = Model.StoreBranding;
}
<!DOCTYPE html>
<html lang="@(ViewData["TicketSalesLanguage"] ?? (string.IsNullOrEmpty(System.Globalization.CultureInfo.CurrentUICulture.Name) ? "en" : System.Globalization.CultureInfo.CurrentUICulture.Name))" @(Env.IsDeveloping ? " data-devenv" : "")>
<head>
    <title>@ViewData["Title"]</title>
    <partial name="LayoutHead" />
    @await RenderSectionAsync("PageHeadContent", false)
    <meta name="robots" content="noindex,nofollow">
</head>
<body class="min-vh-100">
    @RenderBody()

    <partial name="LayoutFoot" />
    <partial name="_ValidationScriptsPartial" />

    @await RenderSectionAsync("PageFootContent", false)
</body>
</html>
